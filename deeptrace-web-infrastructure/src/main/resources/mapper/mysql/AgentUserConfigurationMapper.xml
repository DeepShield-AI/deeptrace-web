<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.qcl.mapper.mysql.AgentUserConfigurationMapper">

    <resultMap type="cn.edu.qcl.agent.AgentUserConfigurationDO" id="AgentUserConfigurationMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="lcuuid" column="lcuuid" jdbcType="CHAR"/>
        <result property="agentLcuuid" column="agent_lcuuid" jdbcType="CHAR"/>
        <result property="yaml" column="yaml" jdbcType="LONGVARCHAR"/>
        <result property="userId" column="user_id" jdbcType="BIGINT"/>
        <result property="status" column="status" jdbcType="VARCHAR"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
        <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- Query the latest agent user configuration matching the filter criteria -->
    <!-- Status is fixed to 'pending' or 'success', only returns records with these statuses -->
    <select id="queryLatest" resultMap="AgentUserConfigurationMap">
        select id, lcuuid, agent_lcuuid, yaml, user_id, status, created_at, updated_at
        from agent_user_configuration
        <where>
            <if test="agentUserConfigurationDO.agentLcuuid != null and agentUserConfigurationDO.agentLcuuid != ''">
                and agent_lcuuid = #{agentUserConfigurationDO.agentLcuuid}
            </if>
            <if test="agentUserConfigurationDO.userId != null">
                and user_id = #{agentUserConfigurationDO.userId}
            </if>
            and status in ('pending', 'failed')
        </where>
        order by updated_at desc
        limit 1
    </select>

</mapper>